# 复制本文件为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。

# ── Ollama ──────────────────────────────────────────────
# 必须是 Ollama 的 API 端口（默认 11434）。
# 注意：Ollama 桌面版的 Web 界面是另一个端口（形如 5xxxx），填错的话
# /api/chat 会返回 HTML 而不是 JSON，表现为「流式解析失败、没有任何输出」。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 默认模型（需先 ollama pull qwen3.5:2b）
DEFAULT_MODEL=qwen3.5:2b

# 服务端口
PORT=3000

# ── 上下文与生成 ─────────────────────────────────────────
# NUM_CTX 是 Ollama 的上下文窗口，同时装「提示词 + 本次输出」，
# 装不下会静默截断，连 system prompt 都可能被丢掉。
# MAX_CONTEXT_CHARS 会被程序自动收敛到 num_ctx 装得下的量（启动时若有收敛会打警告）。
NUM_CTX=4096
NUM_PREDICT=768
NUM_PREDICT_THINKING=1536
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_CHARS=12000
TEMPERATURE=0.7
KEEP_ALIVE=30m

# ── 超时保护（本机 CPU 推理慢，别调太小）──────────────────
FIRST_TOKEN_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=60000
WEATHER_TIMEOUT_MS=15000
WARMUP=true

# ── 安全 ────────────────────────────────────────────────
# 留空表示不校验。若要对外提供服务，务必设置
ACCESS_TOKEN=
RATE_LIMIT_PER_MIN=60
# 跨域白名单（逗号分隔完整 origin）。localhost / 127.0.0.1 默认放行
CORS_ORIGINS=

# ── 天气工具（聚合数据 · 简易天气预报）─────────────────────
# 留空 = 功能静默关闭，/api/chat 行为与未接入时完全一致
# 普通会员额度仅 50 次/天，同城市结果默认缓存 10 分钟
JUHE_WEATHER_KEY=
WEATHER_CACHE_TTL_MS=600000
# 用户说「我所在的城市 / 当地天气」时按此城市查询；留空则追问用户所在城市
WEATHER_DEFAULT_CITY=

# ── 工具调用（Tool Calling）───────────────────────────────
# 总开关：false 则完全不向模型提供任何工具，/api/chat 行为与未接入时一致
ENABLE_TOOLS=true
# 订单数据源：默认指向项目根目录的「快递信息.csv」，可改成绝对路径
# ORDER_DATA_FILE=/absolute/path/to/快递信息.csv
