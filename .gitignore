# ── 依赖 ───────────────────────────────────────────────
node_modules/

# ── 环境变量（含密钥，绝不提交）───────────────────────
.env
.env.*
!.env.example

# ── 运行时数据（SQLite 会话库，启动会自动重建）────────
server/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── 日志 ───────────────────────────────────────────────
*.log
npm-debug.log*

# ── 本地临时文件 / 历史备份（不进仓库）────────────────
.archive/
.workbuddy/
server/_*.js

# ── 编辑器与系统文件 ───────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
